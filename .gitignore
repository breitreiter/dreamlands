bin/
obj/
assets/
!ui/web/src/assets/
.idea/
.claude/
*.DotSettings.user
appsettings.json
local.settings.json
# forge pipeline: peer-JSON sidecars + integrate output are work-product/derived,
# never committed (the promoted .enc is the product). Raw key files never committed.
*.enc.json
out/
*.key
map_*.png
map_*.json
*.kate-swp
*~
mapgen/sizing.md
.vscode/
*.sh
# Leading slash anchors to the repo root, so this un-ignores ONLY the top-level
# deploy script — a downstream utility named deploy.sh stays ignored.
!/deploy.sh
!worlds/*/build.sh
!worlds/*/use.sh
!worlds/*/rebuild.sh
!text/encounter-tool/skills/**/*.sh
.deploy/
mapgen/reference/
generated_*.enc
encounter_*.enc
# fixme/colorize/factual backup files (written next to original as _<name>.enc)
text/encounters/**/_*.enc
.play-tmp/
worlds/*/tiles/
worlds/*/map.png
worlds/*/assets/
worlds/*/encounters/
worlds/*/encounters.bundle.json
worlds/*/combat/
.wrangler/
saves/
.session.json
stock_characters_curated.md
text/encounters/generation/v2/neutral_archetypes.md
text/encounter-tool/EncounterCli/voices/
dreamlands.imp-proposals/
.imp/

# imp/note: capture surface; ephemeral, not worth tracking.
# Keep dir scaffolding (.gitkeep already committed in each subdir).
imp/note/inbox/*
imp/note/processed/*
imp/note/discarded/*
!imp/note/*/.gitkeep

# imp/health: local health snapshots; ephemeral, not worth tracking.
imp/health/
imp/_meta/health-watermark
